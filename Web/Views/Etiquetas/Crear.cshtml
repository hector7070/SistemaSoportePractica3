@model EtiquetaCrearVm
@{
    ViewData["Title"] = "Nueva etiqueta";
}

<h1 class="h3 mb-3">Nueva etiqueta</h1>

<form method="post" asp-action="Crear">
    @* Errores generales (los que no pertenecen a un campo), por ejemplo un 409 de nombre duplicado o 422 *@
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="mb-3">
        <label asp-for="Nombre" class="form-label">Nombre</label>
        <input asp-for="Nombre" class="form-control" placeholder="Ej. Urgente, Bug, Consulta" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Color" class="form-label">Color (código hexadecimal)</label>
        <div class="input-group">
            <input asp-for="Color" class="form-control" placeholder="#ff8800" />
            <input type="color" class="form-control form-control-color" id="selectorColor" value="@(string.IsNullOrEmpty(Model.Color) ? "#6c757d" : Model.Color)" title="Seleccionar color" />
        </div>
        <div class="form-text">Debe ser un código hexadecimal válido de 6 caracteres con # (ejemplo: #ff8800).</div>
        <span asp-validation-for="Color" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Crear</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const inputColor = document.getElementById("Color");
        const selectorColor = document.getElementById("selectorColor");
        if (inputColor && selectorColor) {
            selectorColor.addEventListener("input", function () {
                inputColor.value = selectorColor.value;
            });
            inputColor.addEventListener("input", function () {
                if (/^#[0-9a-fA-F]{6}$/.test(inputColor.value)) {
                    selectorColor.value = inputColor.value;
                }
            });
        }
    });
</script>
