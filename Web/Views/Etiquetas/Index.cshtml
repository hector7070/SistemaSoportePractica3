@model List<EtiquetaVm>
@{
    ViewData["Title"] = "Etiquetas";
}

<h1 class="h3 mb-3">Etiquetas</h1>

<div class="mb-3 d-flex gap-2">
    <a asp-action="Crear" class="btn btn-primary">Nueva etiqueta</a>
</div>

<p class="text-muted">@Model.Count etiqueta(s) registrada(s)</p>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No hay etiquetas registradas.</div>
}
else
{
    <table class="table table-striped table-hover bg-white border">
        <thead class="table-light">
            <tr>
                <th style="width: 80px;">Id</th>
                <th>Nombre</th>
                <th>Insignia</th>
                <th>Color</th>
                <th style="width: 140px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var etiqueta in Model)
            {
                <tr>
                    <td>@etiqueta.Id</td>
                    <td>@etiqueta.Nombre</td>
                    <td>
                        <partial name="_InsigniaColor" model="etiqueta" />
                    </td>
                    <td>
                        <code>@etiqueta.Color</code>
                    </td>
                    <td>
                        <a asp-action="Detalle" asp-route-id="@etiqueta.Id" class="btn btn-sm btn-outline-secondary">Ver detalle</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
